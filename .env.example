##############################################################################
# AlphaOS — environment variables
#
# Copy this file to `.env.local` and fill in the values. `.env.local` and
# `.env` are gitignored; this template (`.env.example`) is committed.
# Never commit real secrets.
##############################################################################


# =============================================================================
# App
# -----------------------------------------------------------------------------
# Public base URL of this app. Used for building absolute URLs and OAuth
# callbacks. Set to your deployed URL in production.
# =============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# =============================================================================
# Database — Neon (serverless Postgres)
# -----------------------------------------------------------------------------
# From the Neon dashboard: Project → Connection Details → connection string
# (use the pooled connection string).
#
# RLS MODEL: the app must connect as the NON-OWNER role `app_user` so row-level
# security applies (a table owner bypasses non-forced RLS). DATABASE_URL is the
# app connection (app_user). DIRECT_URL is the OWNER connection used only by
# Drizzle Kit for migrations. See lib/db/migrations/0001_rls_policies.sql.
# =============================================================================
DATABASE_URL="postgresql://app_user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://owner:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Shop-credential encryption (AES-256-GCM). 32 bytes as 64 hex chars.
# Generate with:  openssl rand -hex 32
# Used by lib/db/credentials.ts; rotating it invalidates stored credentials.
ENCRYPTION_KEY=""


# =============================================================================
# Auth — Auth.js / NextAuth v5 (email + password, Credentials provider)
# -----------------------------------------------------------------------------
# AUTH_SECRET:  generate one with `npx auth secret` (or `openssl rand -base64 32`).
#               Signs the JWT session; required.
# AUTH_URL:     canonical URL of the app; usually only needed behind a proxy
#               or on a custom deployment. Optional in local dev.
#
# There is no signup and no OAuth/magic-link. Accounts are created by an admin
# via `npm run create-user` or by the seed script. Passwords are bcrypt-hashed.
# =============================================================================
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"


# =============================================================================
# Etsy — Open API v3  (per-shop credentials)
# -----------------------------------------------------------------------------
# App-level keys from the Etsy developer portal:
#   https://www.etsy.com/developers/your-apps  ("Keystring" + "Shared secret")
# The OAuth redirect URI must match what you register with Etsy.
# =============================================================================
ETSY_API_KEYSTRING=""
ETSY_SHARED_SECRET=""
ETSY_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/etsy/callback"

# Per-shop OAuth2 tokens (obtained when a seller connects their shop). These
# define a single default shop for local dev; additional shops' tokens are
# stored per-shop in the database.
ETSY_DEFAULT_SHOP_ID=""
ETSY_DEFAULT_SHOP_ACCESS_TOKEN=""
ETSY_DEFAULT_SHOP_REFRESH_TOKEN=""


# =============================================================================
# Shopify — Admin API  (per-shop credentials)
# -----------------------------------------------------------------------------
# App-level credentials from the Shopify Partner dashboard → Apps → (your app)
# → API credentials. SHOPIFY_SCOPES is a comma-separated list of access scopes.
# SHOPIFY_WEBHOOK_SECRET is the app's client secret / signing key used to verify
# webhook HMAC signatures.
# =============================================================================
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,write_orders,read_customers,read_products,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_WEBHOOK_URL="https://your-production-domain.com/api/shopify/webhook"
SHOPIFY_API_VERSION="2025-01"
SHOPIFY_WEBHOOK_SECRET=""

# Per-shop credentials (minted when a merchant installs the app). These define a
# single default shop for local dev; additional shops' tokens are stored
# per-shop in the database.
SHOPIFY_DEFAULT_SHOP="your-store.myshopify.com"
SHOPIFY_DEFAULT_ACCESS_TOKEN=""


# =============================================================================
# Cloudflare R2 — object storage (S3-compatible), PRIVATE bucket
# -----------------------------------------------------------------------------
# From the Cloudflare dashboard → R2. Create a bucket and an R2 API token
# (Account → R2 → Manage R2 API Tokens) for the access key / secret. The bucket
# stays private: uploads use presigned PUT, reads use presigned GET.
# Only these four names are read by the code.
# R2_ENDPOINT is https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# =============================================================================
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""


# =============================================================================
# Vercel Cron — background job auth
# -----------------------------------------------------------------------------
# Set this in the Vercel project. Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` on cron invocations; the /api/cron/*
# routes reject anything else. Schedules live in vercel.json.
# =============================================================================
CRON_SECRET=""

# Notification SLA sweep kill switch. Default is OFF unless explicitly set to
# true in Vercel. When off, /api/cron/notifications computes and logs the dry-run
# report but does not create notification_fires or notifications.
NOTIFICATIONS_ENABLED="false"


# =============================================================================
# Anthropic — daily health report narrative
# -----------------------------------------------------------------------------
# The dashboard computes all metrics locally on every load. Once per calendar
# day per dashboard scope, it can send aggregate-only metrics to Claude to cache
# a short operations narrative. Customer names, emails, and order contents are
# never sent. If ANTHROPIC_API_KEY is unset or the call fails, metrics still
# render and the dashboard uses the last cached narrative or a plain fallback.
# =============================================================================
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"


# =============================================================================
# Gmail / Google Workspace — customer email
# -----------------------------------------------------------------------------
# Gmail is connected per business from Settings. Each business gets its own
# Google Cloud OAuth Web client and authorizes the actual sending mailbox
# (for example orders@yourbusiness.com). Client IDs, client secrets, refresh
# tokens, and mailbox history cursors are stored per business in the database;
# no Gmail service-account or SMTP credentials are configured in env.
# See docs/GMAIL_SETUP.md.
# =============================================================================
